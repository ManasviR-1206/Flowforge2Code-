# FlowForge AI – Environment Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Google Gemini API Key
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Optional: Server port (default 8000)
PORT=8000

# Optional: Tesseract OCR executable (Windows default is detected automatically)
# TESSERACT_CMD="C:\Program Files\Tesseract-OCR\tesseract.exe"

# ---------------------------------------------------------------------------
# Python execution of generated code (the /api/execute endpoint)
# ---------------------------------------------------------------------------
# auto      (default) run code only if the Bubblewrap sandbox is installed and ALL
#           startup self-checks pass; otherwise execution is DISABLED with a reason
#           (see "execution" in GET /api/health). The server must run as non-root.
# sandbox   same as auto, but stated explicitly
# off       never execute code
# local-dev UNSAFE. Runs code in a plain subprocess with NO isolation. Only for your
#           own machine (e.g. a local Windows demo). Only direct loopback clients are
#           accepted. NEVER set this on a public/hosted deployment.
FLOWFORGE_EXECUTION=auto

# Optional limits (defaults shown)
# FLOWFORGE_EXEC_TIMEOUT=5
# FLOWFORGE_EXEC_MEMORY_MB=256
# FLOWFORGE_EXEC_MAX_OUTPUT_BYTES=65536
# FLOWFORGE_EXEC_MAX_CODE_CHARS=20000
# FLOWFORGE_EXEC_MAX_INPUT_CHARS=4000
# FLOWFORGE_EXEC_MAX_CONCURRENT=2
# FLOWFORGE_EXEC_TMPFS_MB=8
# FLOWFORGE_EXEC_MAX_PROCS=16
