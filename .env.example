# FlowForge AI – Environment Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Google Gemini API Key
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Optional: Server port (default 8000)
PORT=8000

# Optional: Tesseract OCR executable (Windows default is detected automatically)
# TESSERACT_CMD="C:\Program Files\Tesseract-OCR\tesseract.exe"

# ==============================================================================
# Code Execution & Sandboxing Configuration (Stage 1)
# ==============================================================================
# FLOWFORGE_EXECUTION:
#   auto      - (Default) Only enables execution if genuine OS-level sandbox isolation
#               is verified; fails closed (disabled) if no sandbox is available.
#   local-dev - UNSAFE: Allows local subprocess execution for trusted local development
#               and college demonstrations on Windows. Never use on public deployments.
#   disabled  - Completely disables code execution (/api/execute returns disabled).
FLOWFORGE_EXECUTION=auto

# Execution Resource & Concurrency Limits:
# Maximum code size in characters / bytes (default: 65536 = 64KB)
FLOWFORGE_MAX_CODE_SIZE=65536

# Maximum stdout/stderr output size before truncation (default: 32768 = 32KB)
FLOWFORGE_MAX_OUTPUT_SIZE=32768

# Maximum concurrent code execution subprocesses (default: 4)
FLOWFORGE_MAX_CONCURRENT_EXECUTIONS=4

# Execution timeout in seconds (default: 5, max allowed: 15)
FLOWFORGE_EXECUTION_TIMEOUT=5
